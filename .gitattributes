# 统一行尾：Windows 结算 CRLF，仓库存 LF
* text=auto eol=lf

# 二进制文件明确标记，防止 git 误处理
*.dll     binary
*.exe     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.zip     binary
*.7z      binary
*.pyd     binary
*.pyz     binary
*.pyc     binary

# NSIS 脚本用 CRLF（makensis 在 Windows 上更兼容）
*.nsi     text eol=crlf
*.nsh     text eol=crlf
